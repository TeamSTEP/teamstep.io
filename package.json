{
  "name": "teamstep-io",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:all": "node scripts/dev-with-ds.mjs",
    "build": "node scripts/generate-og.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "ds:use-local": "node scripts/ds-mode.mjs local",
    "ds:use-published": "node scripts/ds-mode.mjs published",
    "ds:build": "CI=true pnpm --dir ../brand-assets --filter @teamstep/design-system build",
    "ds:watch": "CI=true pnpm --dir ../brand-assets --filter @teamstep/design-system dev"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.17",
    "@teamstep/design-system": "^1.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "fast-xml-parser": "^5.11.2",
    "motion": "^12.43.0",
    "oxc-transform-react": "^0.145.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
