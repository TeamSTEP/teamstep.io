---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const games = await getCollection("games");
const featured = games.find((game) => game.data.featured);
const catalog = games
  .filter((game) => !game.data.featured)
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);
---

<BaseLayout>
  <main>
    <section id="boot" data-section="boot" style="padding: 96px 40px; min-height: 55vh;">
      <p style="font-family: var(--font-family-subtitle); font-style: italic; color: var(--color-muted);">
        indie game studio
      </p>
      <h1 style="font-family: var(--font-family-heading); text-transform: uppercase; letter-spacing: 0.04em; font-size: clamp(48px, 8vw, 88px); margin: 12px 0;">
        Team Step
      </h1>
      <p style="max-width: 36ch; color: var(--color-ice); font-size: 20px;">
        Building the home for the indie game world.
      </p>
      <p style="margin-top: 24px; color: var(--color-muted); font-size: 14px;">
        Scaffold ready — wireframe chapters land next. Design system tokens are loaded.
      </p>
    </section>

    <section id="meltdown" data-section="games" style="padding: 64px 40px; border-top: 1px solid var(--color-mid);">
      <h2 style="font-family: var(--font-family-heading); text-transform: uppercase;">
        Featured
      </h2>
      {
        featured ? (
          <p>
            {featured.data.title} — {featured.data.subtitle} ({featured.data.phase})
          </p>
        ) : (
          <p>No featured game.</p>
        )
      }
    </section>

    <section id="quest-log" style="padding: 64px 40px; border-top: 1px solid var(--color-mid);">
      <h2 style="font-family: var(--font-family-heading); text-transform: uppercase;">
        Quest Log
      </h2>
      <ul>
        {
          catalog.map((game) => (
            <li>
              {game.data.title} — {game.data.phase}
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</BaseLayout>
